# NEXUS OMNIS configuration. Copy to .env and adjust. Never commit .env.
# Every value is optional for the local SIMULATION demo.

# simulation | real-lab   (real-lab enables real network probes; adapters are chosen below)
NEXUS_ENV=simulation
NEXUS_HTTP_PORT=8000
NEXUS_SITE_TIMEZONE=Asia/Baku

# --- Security ------------------------------------------------------------------------------
# Signs console tokens. If unset, a random key is generated at start (sessions reset on restart).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
NEXUS_SECRET_KEY=
# Demo login (pick an operator in the UI). Set to false for anything shared, and use API keys.
NEXUS_DEMO_AUTH=true
# API keys as ROLE:key pairs, e.g. ADMIN:<long-random>,VIEWER:<long-random>
NEXUS_API_KEYS=
# Optional shared secret Alertmanager must send as "Authorization: Bearer <token>"
NEXUS_ALERTMANAGER_TOKEN=
NEXUS_RATE_LIMIT_PER_MINUTE=60
NEXUS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Control loop -----------------------------------------------------------------------------
# 0 Observe, 1 Alert, 2 Recommend, 3 Reversible AutoHeal (default), 4 Critical AutoHeal, 5 Autonomous Quarantine
NEXUS_AUTONOMY_LEVEL=3
NEXUS_RECONCILE_INTERVAL=20
NEXUS_DETECTION_INTERVAL=2
NEXUS_SIM_TICK_INTERVAL=2
NEXUS_STEP_DELAY_MS=650

# --- ChatOps (DRY_RUN when unset: messages are recorded, nothing is sent) ----------------------
# none | discord | slack
CHATOPS_PROVIDER=none
CHATOPS_WEBHOOK_URL=

# --- Optional real-lab adapters (EXPERIMENTAL, not used by the demo) ---------------------------
# mock | pfsense
NEXUS_FIREWALL_ADAPTER=mock
PFSENSE_URL=
PFSENSE_API_KEY=
PFSENSE_VERIFY_TLS=true
# simulated | ansible
NEXUS_EXECUTOR=simulated

# --- Database ---------------------------------------------------------------------------------
# Docker uses sqlite:////data/nexus.db. PostgreSQL: postgresql+psycopg://nexus:<password>@db:5432/nexus
# DATABASE_URL=
